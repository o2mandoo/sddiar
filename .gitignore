artifacts/**/tooling/wheels/

# User-provided source transcript at the repository root.
/*.txt

# Per-span/private-timing experiment outputs. Curated aggregate evidence,
# manifests, hashes, and reports remain trackable.
experiments/**/result-*.json
experiments/**/proxy-*.json
